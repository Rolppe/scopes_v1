+  assert.deepEqual(sendKeys1, [['Down'], ['Enter']]);
+
+  // 2. Vastaaminen custom write-in -tekstillä ("Oma teksti")
+  kutsut.length = 0;
+  ruutuTeksti = 'Question 1/1: Vahvistatko?\n> 1. Kyllä\n  2. Ei\n  ↑/↓ Navigate · enter Select · esc Skip\n';
