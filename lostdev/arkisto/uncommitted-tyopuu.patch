 # Kirjautumaton agy odottaa jokaisella -p-kutsulla 60 s kirjautumista, ja vaihesilmukka ehtisi
 # yrittää monta kertaa ennen varareittiä (SIIRTO-AGY-ONEPLUS 25.9.2026). `agy models` vastaa alle
 # 2 sekunnissa ja epäonnistuu ilman kirjautumista; kirjautuminen: aja `agy` ilman argumentteja.
-if [ "$MOOTTORI" = "agy" ] && ! timeout 20 agy models </dev/null >/dev/null 2>&1; then
+TIMEOUT_BIN=""
+if command -v timeout >/dev/null 2>&1; then TIMEOUT_BIN="timeout 20"
+elif command -v gtimeout >/dev/null 2>&1; then TIMEOUT_BIN="gtimeout 20"
+elif [ -x "/opt/homebrew/opt/coreutils/libexec/gnubin/timeout" ]; then TIMEOUT_BIN="/opt/homebrew/opt/coreutils/libexec/gnubin/timeout 20"
+fi
+if [ "$MOOTTORI" = "agy" ] && ! $TIMEOUT_BIN agy models </dev/null >/dev/null 2>&1; then
   echo "AJAJA: agy ei kirjautunut tai ei vastaa — varareitti (kirjaudu: aja agy ilman argumentteja)"
   [ "$MODE" = "pura" ] && exit 10
   exit 3
diff --git a/claude/siirto/tools/autovaihto.sh b/claude/siirto/tools/autovaihto.sh
