 esac
 
+# Jos ajetaan Macilla SSH-yhteyden yli OnePlus-palvelimelta, delegoidaan autovaihto OnePlus-palvelimelle,
+# missä Scopes-taustapalvelu (palvelin.mjs) ja istunnon tmux-ikkunat sijaitsevat (V-555, 18.10.2026).
+if [ "$(uname -s)" = "Darwin" ] && [ -n "${SSH_CLIENT-}" ] && [ "${AUTOVAIHTO_DELEGOITU-}" != "1" ]; then
+  case "$SSH_CLIENT" in
+    192.0.2.11*)
+      if ssh -o BatchMode=yes -o ConnectTimeout=3 palvelin true 2>/dev/null; then
+        exec ssh palvelin "cd ~/palvelin && AUTOVAIHTO_DELEGOITU=1 bash claude/siirto/tools/autovaihto.sh vaihda \"$SKOOPPI\" $(printf ' %q' "$@")"
+      fi
+      ;;
+  esac
+fi
+
 # Paikallinen istunto (käyttäjä 15.10.2026: "Paikalliset mallit pitää saada myös keskustelun ajoon"): --model
 # palvelin/<id> ajaa Claude Coden palvelimen LM Studiota vasten (Anthropic-yhteensopiva /v1/messages). LM Studio
 # kuuntelee vain palvelimen 127.0.0.1:1234:ää, joten väliin tulee ssh-tunneli LM_URL:iin. Remote Control ei toimi
@@ -46,6 +58,7 @@ LM_ETULIITE="palvelin/"
 # (vain scopes-perhe). Ei Remote Controlia, ja agy tallentaa keskustelun ~/.gemini/antigravity-cli/conversations-hakemistoon,
 # joten istunto ei näy Scopes-äpin istuntolistassa; se löytyy tmuxista (`tmux attach -t siirto-…`). Effort on mallin tunnuksessa.
 AGY_ETULIITE="agy/"
+MAC_AGY_ETULIITE="mac-agy/"
 LM_URL="http://127.0.0.1:${AUTOVAIHTO_LM_PORTTI:-11234}"
 LM_KONTEKSTI="${AUTOVAIHTO_LM_KONTEKSTI:-98304}"
